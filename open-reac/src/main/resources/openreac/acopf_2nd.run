# Transformer ratios rounded to their closest tap and fixed, then solved with the discrete shunts still continuous
if optimization_after_rounding == "true" and card(BRANCHCC_REGL_VAR) > 0 then {
  printf{LOG_DEBUG} "\n* Rounding all the taps of optimized transformers\n";
  for{(qq,m,n) in BRANCHCC_REGL_VAR} {
      # smallest difference between continuous value and transformer ratios
      let temp1 := min{(1,regl_table[1,branch_ptrRegl[1,qq,m,n]],tap) in TAPS}
              abs(branch_Ror_var[qq,m,n]-tap_ratio[1,regl_table[1,branch_ptrRegl[1,qq,m,n]],tap]);
      # closest tap
      let temp2 := min{(1,regl_table[1,branch_ptrRegl[1,qq,m,n]],tap) in TAPS:
              abs(branch_Ror_var[qq,m,n]-tap_ratio[1,regl_table[1,branch_ptrRegl[1,qq,m,n]],tap])<=1.00001*temp1}tap; # closest tap
      # transformer ratio of the closest tap
      let temp1 := tap_ratio[1,regl_table[1,branch_ptrRegl[1,qq,m,n]],temp2]; # transformer ratio of closest tap

      printf{LOG_DEBUG} "REGL=%Q ptrRegl=%i regl_table=%i Ror_var=%f -> tap=%i tap_ratio=%f err=%f\n",
          branch_id[1,qq,m,n],branch_ptrRegl[1,qq,m,n],regl_table[1,branch_ptrRegl[1,qq,m,n]],
          branch_Ror_var[qq,m,n], temp2, temp1,
          abs(branch_Ror_var[qq,m,n]-temp1);
      # update the transformer ratio of the transformer
      let branch_Ror_var[qq,m,n] := temp1;
  }

  printf{LOG_DEBUG} "\n* Fixing all variable transformer ratios in next optimization\n";
  fix{(qq,m,n) in BRANCHCC_REGL_VAR} branch_Ror_var[qq,m,n];

  # Ratios are now fixed to their independently-rounded discrete values; a tie/fix
  # constraint could contradict that, so relax them for the post-rounding solve.
  drop ctr_parallel_bundle_ratio;
  drop ctr_fixed_ratio;

  solve problem_acopf_objective;
  let nb_iter_total := nb_iter_total + problem_acopf_objective.numiters;
  let objective_value_second := problem_acopf_objective;
}

# Discrete shunts rounded on each bus (see commons.mod) from the last solving, fixed and solved
if solve_result_num <= 103 and card(SHUNT_DISCRETE) > 0 then {
  let {(s,n) in SHUNT_DISCRETE} shunt_sections_continuous[s,n] :=
    min(shunt_sections_max[s,n], max(0, shunt_var[s,n] / shunt_section_b[s,n]));
  if card(SHUNT_DISCRETE_BUS diff SHUNT_ROUNDING_BUS) > 0 then
    printf{LOG_WARNING} "Discrete shunts: %i bus(es) with more than %i combinations of sections, rounded to the closest sections\n",
      card(SHUNT_DISCRETE_BUS diff SHUNT_ROUNDING_BUS), shunt_rounding_count_max;
  let {(s,n) in SHUNT_DISCRETE} shunt_var[s,n] := shunt_section_b[s,n] * shunt_sections[s,n];
  fix {(s,n) in SHUNT_DISCRETE} shunt_var[s,n];

  solve problem_acopf_objective;
  let nb_iter_total := nb_iter_total + problem_acopf_objective.numiters;
  # second solving when the transformer ratios are not rounded
  if optimization_after_rounding != "true" or card(BRANCHCC_REGL_VAR) == 0 then
    let objective_value_second := problem_acopf_objective;
}
